# SERVER
PORT=5000
CLIENT_URL=http://localhost:5173

# MONGODB
# Example: mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/gameworld?appName=Cluster0
MONGODB_URI=

# FIREBASE ADMIN SDK
# You can extract these from the JSON file provided by the Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
